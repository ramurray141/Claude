# Copy to .env and fill in only the channels you use. .env is git-ignored.

# --- ntfy.sh push notifications (phone/desktop app, free, no account) ---
# Pick a long, hard-to-guess topic name: anyone who knows it can read your alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
